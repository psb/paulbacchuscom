---
import { Font } from "astro:assets";
// import "../styles/global.css";
import "../styles/main.css";
import SVGDistortionFilter from "../components/SVGDistortionFilter.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const isHome = title === "Home";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-inter-variable" />
    <Font cssVariable="--font-jetbrains-mono-variable" />
    <Font cssVariable="--font-jetbrains-mono-regular" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Paul Bacchus</title>
  </head>
  <body>
    <!-- <SVGDistortionFilter /> -->
    <a href="#main" class="skip">Skip to main content</a>
    <!-- Left column -->
    <div class="col-left" aria-hidden="true"></div>
    <!-- Main column for content -->
    <div class="col-center">
      <div class="header-wrapper">
        <Header />
      </div>
      <main id="main">
        <article>
          <h1 class:list={["title", { home: isHome }]}>
            {isHome ? "Paul Bacchus" : title}
          </h1>
          <div class="content-wrapper">
            <slot />
          </div>
        </article>
      </main>
      <Footer />
    </div>
    <!-- Right column -->
    <div class="col-right" aria-hidden="true"></div>
  </body>
</html>

<style>
  /* Skip link */
  .skip {
    position: absolute;
    top: -100px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Media sizes from Tailwind: https://tailwindcss.com/docs/responsive-design */
  /* Styles for mobile: (<40rem <640px) */
  body {
    /* 1024px */
    --max-width: 64rem;
    /* 1280px */
    /* --max-width: 80rem; */

    display: grid;
    grid-template-columns: 1fr min(100vw, var(--max-width)) 1fr;
    grid-template-rows: auto auto 1fr auto;
  }

  .col-left {
    background-color: var(--color-magenta);
    /* display: none; */
  }

  .col-center {
    background-color: var(--color-cyan);
    /* width: 100%; */
    /* To push footer to bottom of page. See footer for margin-top: auto */
    /* display: flex; */
    /* flex-direction: column; */
    /* min-height: 100vh; */
    /* modern height (mobile) */
    /* min-height: 100svh; */
  }

  .col-right {
    background-color: var(--color-yellow);
    /* display: none; */
  }

  .title {
    font-size: 3rem;
    font-weight: 900;
    padding: 1rem;
  }

  .content-wrapper {
    padding: 1rem;
    max-width: 750px;
    margin: 0 auto;
  }

  /* Styles for sm: >=40rem (640px) */
  @media (width >= 40rem) {
    .title {
      font-size: 4rem;
    }
  }

  /* Styles for md: >=48rem (768px) */
  @media (width >= 48rem) {
    .title {
      font-size: 4.5rem;
    }
  }

  /* Styles for lg: >=64rem (1024px) */
  @media (width >= 64rem) {
    .title {
      font-size: 5rem;
    }
    .title.home {
      font-size: 7rem;
    }
  }

  /* Styles for xl: >=80rem (1280px) */
  @media (width >= 80rem) {
  }

  /* Styles for 2xl: >=96rem (1536px) */
  @media (width >= 96rem) {
  }
</style>
