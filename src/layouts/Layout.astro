---
import { Font } from "astro:assets";
import "../styles/main.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import willSmith from "../assets/images/will-smith.png";
import butterfield from "../assets/images/butterfield-www.png";
import Play from "../assets/icons/play-fill.svg";
import ExternalLinkIcon from "../assets/icons/arrow-square-out.svg";

interface Props {
  title: string;
  ogImage: string;
  noFontFeatures: boolean;
}

const { title, ogImage, noFontFeatures } = Astro.props;
const isHome = title === "Home";
const fontXL = title === "Home" || title === "404";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-inter-variable" />
    <Font cssVariable="--font-jetbrains-mono-regular" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Paul Bacchus's Personal Website." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Paul Bacchus" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- og image -->
    <meta
      property="og:image"
      content=`https://www.paulbacchus.com/${ogImage}`
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:secure_url"
      content=`https://www.paulbacchus.com/${ogImage}`
    />
    <meta property="og:image:alt" content=`${title}` />
    <!--  -->
    <title>{title} | Paul Bacchus</title>
  </head>
  <body id="body">
    <a href="#main" class="skip">Skip to main content</a>
    <!-- Left column -->
    <div class="col-left" aria-hidden="true">
      <div class="col-left-header"></div>
      <div class="col-left-title"></div>
      <div class="col-left-content">
        <audio id="butterfieldAudio" src="/butterfield-pb.mp3"></audio>
        <div class="butterfield">
          <div class="image-and-button">
            <Image src={butterfield} alt="" layout="constrained" width={400} />
            <button id="play-button">
              <Play
                height="1.2rem"
                width="1.2rem"
                role="img"
                aria-labelledby="play"
              />
              <span>play</span>
            </button>
          </div>
        </div>
      </div>
      <div class="col-left-footer">
        <div class="butterfield-link">
          <a
            href="https://www.youtube.com/watch?v=cCLn94xi1LQ"
            target="_blank"
            rel="noreferrer"
            >The Butterfield Diet
            <ExternalLinkIcon height="1rem" width="1rem" />
          </a>
        </div>
      </div>
    </div>
    <!-- Main column for content -->
    <div class="col-center">
      <Header />
      <main id="main">
        <article>
          <h1
            class:list={[
              "title",
              { "font-xl": fontXL },
              { "no-font-features": noFontFeatures },
            ]}
          >
            {isHome ? "Paul Bacchus" : title}
          </h1>
          <div class="content-wrapper">
            <slot />
          </div>
        </article>
      </main>
      <Footer />
    </div>
    <!-- Right column -->
    <div class="col-right" aria-hidden="true">
      <div class="col-right-header"></div>
      <div class="col-right-title"></div>
      <div class="col-right-content">
        <div class="willsmith">
          <a
            href="https://www.youtube.com/watch?v=3JcmQONgXJM&t=28s"
            target="_blank"
            rel="noreferrer"
          >
            <Image src={willSmith} alt="" layout="constrained" width={500} />
            <br />
            <ExternalLinkIcon width="1rem" height="1rem" />
          </a>
        </div>
      </div>
      <div class="col-right-footer">
        <div class="phosphor">
          Icons from <a href="https://phosphoricons.com">Phosphor</a>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  /* Skip link */
  .skip {
    position: absolute;
    top: -100px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Media sizes from Tailwind: https://tailwindcss.com/docs/responsive-design */
  /* Styles for mobile: (<40rem <640px) */
  body {
    /* 1024px */
    --max-width: 64rem;
    /* 1280px */
    /* --max-width: 80rem; */
    height: 100vh;
    height: 100svh;

    display: grid;
    grid-template-columns: 1fr min(100vw, var(--max-width)) 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "col-left-header col-center-header col-right-header"
      "col-left-title col-center-title col-right-title"
      "col-left-content col-center-content col-right-content"
      "col-left-footer col-center-footer col-right-footer";
  }

  /* Center column styles */
  .col-center {
    display: grid;
    grid-column: 2/-2;
    grid-row: 1/-1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-center > header {
    grid-area: col-center-header;
  }
  .col-center main {
    display: grid;
    grid-row: 2 / 4;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-center article {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-center .title {
    grid-area: col-center-title;
  }
  .col-center .content-wrapper {
    grid-area: col-center-content;
  }
  .col-center > footer {
    grid-area: col-center-footer;
  }

  #main {
    margin-bottom: 15rem;
  }

  .title {
    font-size: clamp(3rem, -0.333rem + 8.333vw, 5rem);
    font-weight: 900;
    padding: 1rem;
  }
  /* .title.font-xl {
    font-size: clamp(3rem, -3.667rem + 16.667vw, 7rem);
  } */
  .title.not-found {
    text-align: center;
  }

  .content-wrapper {
    padding: 0 1.1rem;
  }

  /* Left column styles */
  .col-left {
    display: none;
    grid-column: 1;
    grid-row: 1/-1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    padding: 0 2rem;
  }
  .col-left-header {
    grid-area: col-left-header;
  }
  .col-left-title {
    grid-area: col-left-title;
  }
  .col-left-content {
    grid-area: col-left-content;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr 1fr;
  }
  .col-left-footer {
    grid-area: col-left-footer;
    padding: 1rem;
  }
  .col-left-footer > a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .butterfield {
    grid-row: 3;
    display: flex;
    align-items: flex-start;
  }

  .image-and-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: rotate(-5deg);
    gap: 1rem;
  }

  #play-button {
    display: flex;
    align-items: center;
    text-transform: uppercase;
    font-weight: 500;
    gap: 0.3rem;
    /* remove built-in styles */
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .butterfield-link {
    display: none;
  }
  .butterfield-link > a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Right column styles */
  .col-right {
    display: none;
    grid-column: 3;
    grid-row: 1/-1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    padding: 0 2rem;
  }
  .col-right-header {
    grid-area: col-right-header;
  }
  .col-right-title {
    grid-area: col-right-title;
  }
  .col-right-content {
    grid-area: col-right-content;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr 1fr;
  }
  .col-right-footer {
    grid-area: col-right-footer;
    text-align: right;
    padding: 1rem;
  }

  .willsmith {
    grid-row: 2;
    display: flex;
    justify-content: end;
  }
  .willsmith > a {
    text-align: right;
  }
  .willsmith img {
    transform: rotate(17deg);
  }
  .willsmith > a > svg {
    transform: rotate(17deg);
  }

  .phosphor {
    display: none;
  }

  /* Styles for sm: >=40rem (640px) */
  @media (width >= 40rem) {
  }

  /* Styles for md: >=48rem (768px) */
  @media (width >= 48rem) {
  }

  /* Styles for lg: >=64rem (1024px) */
  @media (width >= 64rem) {
  }

  /* Styles for xl: >=80rem (1280px) */
  @media (width >= 81rem) {
    .col-left {
      display: grid;
    }
    .col-right {
      display: grid;
    }
  }

  /* Styles for 2xl: >=96rem (1536px) */
  @media (width >= 96rem) {
    .phosphor {
      display: inline-block;
    }
    .butterfield-link {
      display: inline-block;
    }
  }
</style>

<script>
  const playButton = document.getElementById("play-button");
  const audio = document.getElementById("butterfieldAudio") as HTMLAudioElement;

  playButton?.addEventListener("click", () => {
    audio.play();
  });
</script>
