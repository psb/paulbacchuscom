---
import { Font } from "astro:assets";
// import "../styles/global.css";
import "../styles/main.css";
import SVGDistortionFilter from "../components/SVGDistortionFilter.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const isHome = title === "Home";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-ibm-plex-sans" />
    <Font cssVariable="--font-nebula-sans" />
    <Font cssVariable="--font-jet-brains-mono" />
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-geist-pixel-circle" />
    <Font cssVariable="--font-caveat" />
    <Font cssVariable="--font-shantell" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Paul Bacchus</title>
  </head>
  <body>
    <!-- <SVGDistortionFilter /> -->
    <a href="#main" class="skip">Skip to main content</a>
    <!-- Main column for content -->
    <div class="col-center">
      <Header />
      <main id="main">
        <article>
          <h1 class:list={["title", { home: isHome }]}>
            {isHome ? "Paul Bacchus" : title}
          </h1>
          <div class="main-area">
            <div class:list={["vertical-name", { home: isHome }]}>
              <a href="/"> Paul Bacchus </a>
            </div>
            <div class="content-wrapper">
              <slot />
            </div>
          </div>
        </article>
      </main>
      <Footer />
    </div>
    <div class="col-left" aria-hidden="true"></div>
    <div class="col-right" aria-hidden="true"></div>
  </body>
</html>

<style>
  /* Media sizes from Tailwind: https://tailwindcss.com/docs/responsive-design */
  /* Styles for mobile: (<40rem <640px) */
  body {
    display: flex;
  }
  .col-center {
    width: 100%;
    /* To push footer to bottom of page. See footer for margin-top: auto */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    /* modern height (mobile) */
    min-height: 100svh;
  }
  .col-left {
    background-color: magenta;
    display: none;
  }
  .col-right {
    background-color: yellow;
    display: none;
  }

  .title {
    font-size: 3rem;
    font-weight: 900;
    padding: 1rem;
  }

  .main-area {
    display: flex;
    align-items: center;
  }

  .content-wrapper {
    padding: 1rem;
    max-width: 750px;
    margin: 0 auto;
  }

  .vertical-name {
    font-family: var(--font-pixel);
    /* font-size: 3rem; */
    writing-mode: vertical-lr;
    text-orientation: mixed;
    font-feature-settings: var(--geist-pixel-font-features);
    padding: 1rem 0;
  }
  .vertical-name > a {
    color: rgba(0, 0, 0, 0.5);
    text-decoration: none;
    &:visited {
      color: black;
      text-decoration: none;
    }
  }
  .vertical-name.home {
    display: none;
  }

  /* Styles for sm: >=40rem (640px) */
  @media (width >= 40rem) {
    .title {
      font-size: 4rem;
    }
  }

  /* Styles for md: >=48rem (768px) */
  @media (width >= 48rem) {
    .title {
      font-size: 4.5rem;
    }

    .vertical-name {
      font-size: 2rem;
    }
  }

  /* Styles for lg: >=64rem (1024px) */
  @media (width >= 64rem) {
    .title {
      font-size: 5rem;
    }

    .vertical-name {
      font-size: 3rem;
    }
  }

  /* Styles for xl: >=80rem (1280px) */
  @media (width >= 80rem) {
    .col-center {
      flex: 0 0 1280px;
      order: 2;
    }
    .col-left {
      display: block;
      order: 1;
    }
    .col-right {
      display: block;
      order: 3;
    }

    .title {
      font-size: 5rem;
    }
  }

  /* Styles for 2xl: >=96rem (1536px) */
  @media (width >= 96rem) {
  }
</style>
