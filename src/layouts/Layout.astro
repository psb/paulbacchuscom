---
import { Font } from "astro:assets";
// import "../styles/global.css";
import "../styles/main.css";
import SVGDistortionFilter from "../components/SVGDistortionFilter.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const isHome = title === "Home";
const isNotFound = title === "404";
const xlFont = title === "Home" || title === "404";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-inter-variable" />
    <Font cssVariable="--font-jetbrains-mono-regular" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Paul Bacchus</title>
  </head>
  <body>
    <!-- <SVGDistortionFilter /> -->
    <a href="#main" class="skip">Skip to main content</a>
    <!-- Left column -->
    <div class="col-left" aria-hidden="true">
      <div class="col-left-header"></div>
      <div class="col-left-title"></div>
      <div class="col-left-content"></div>
      <div class="col-left-footer"></div>
    </div>
    <!-- Main column for content -->
    <div class="col-center">
      <Header />
      <main id="main">
        <article>
          <h1
            class:list={[
              "title",
              { "xl-font": xlFont },
              { "not-found": isNotFound },
            ]}
          >
            {isHome ? "Paul Bacchus" : title}
          </h1>
          <div class="content-wrapper">
            <slot />
          </div>
        </article>
      </main>
      <Footer />
    </div>
    <!-- Right column -->
    <div class="col-right" aria-hidden="true">
      <div class="col-right-header"></div>
      <div class="col-right-title"></div>
      <div class="col-right-content"></div>
      <div class="col-right-footer"></div>
    </div>
  </body>
</html>

<style>
  /* Skip link */
  .skip {
    position: absolute;
    top: -100px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Media sizes from Tailwind: https://tailwindcss.com/docs/responsive-design */
  /* Styles for mobile: (<40rem <640px) */
  body {
    /* 1024px */
    --max-width: 64rem;
    /* 1280px */
    /* --max-width: 80rem; */
    height: 100vh;
    height: 100svh;

    display: grid;
    grid-template-columns: 1fr min(100vw, var(--max-width)) 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "col-left-header col-center-header col-right-header"
      "col-left-title col-center-title col-right-title"
      "col-left-content col-center-content col-right-content"
      "col-left-footer col-center-footer col-right-footer";
  }

  /* Center column styles */
  .col-center {
    display: grid;
    grid-column: 2/-2;
    grid-row: 1/-1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-center > header {
    grid-area: col-center-header;
  }
  .col-center main {
    display: grid;
    grid-row: 2 / 4;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-center article {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-center .title {
    grid-area: col-center-title;
  }
  .col-center .content-wrapper {
    grid-area: col-center-content;
  }
  .col-center > footer {
    grid-area: col-center-footer;
  }

  #main {
    margin-bottom: 15rem;
  }

  .title {
    font-size: clamp(3rem, -0.333rem + 8.333vw, 5rem);
    font-weight: 900;
    padding: 1rem;
  }
  .title.xl-font {
    font-size: clamp(3rem, -3.667rem + 16.667vw, 7rem);
  }
  .title.not-found {
    text-align: center;
  }

  .content-wrapper {
    padding: 0 1.1rem;
  }

  /* Left column styles */
  .col-left {
    display: grid;
    grid-column: 1;
    grid-row: 1/-1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }
  .col-left-header {
    grid-area: col-left-header;
  }
  .col-left-title {
    grid-area: col-left-title;
  }
  .col-left-content {
    grid-area: col-left-content;
  }
  .col-left-footer {
    grid-area: col-left-footer;
  }

  /* Right column styles */
  .col-right {
    display: grid;
    grid-column: 3;
    grid-row: 1/-1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    padding-left: 2rem;
  }
  .col-right-header {
    grid-area: col-right-header;
  }
  .col-right-title {
    grid-area: col-right-title;
  }
  .col-right-content {
    grid-area: col-right-content;
  }
  .col-right-footer {
    grid-area: col-right-footer;
  }

  /* Styles for sm: >=40rem (640px) */
  @media (width >= 40rem) {
    /* .title {
      font-size: 4rem;
    } */
  }

  /* Styles for md: >=48rem (768px) */
  @media (width >= 48rem) {
    /* .title {
      font-size: 4.5rem;
    } */
  }

  /* Styles for lg: >=64rem (1024px) */
  @media (width >= 64rem) {
    /* .title {
      font-size: 5rem;
    }
    .title.home {
      font-size: 7rem;
    } */
  }

  /* Styles for xl: >=80rem (1280px) */
  @media (width >= 80rem) {
  }

  /* Styles for 2xl: >=96rem (1536px) */
  @media (width >= 96rem) {
  }
</style>
