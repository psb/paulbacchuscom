---
import { Font } from "astro:assets";
import "../styles/global.css";
import HeaderNav from "../components/HeaderNav.astro";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-cyan-500">
  <head>
    <Font cssVariable="--font-ibm-plex-sans" />
    <Font cssVariable="--font-nebula-sans" />
    <Font cssVariable="--font-jet-brains-mono" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Paul Bacchus</title>
  </head>
  <body class="grid place-items-center m-4 bg-amber-100">
    <div class="w-full max-w-4xl bg-amber-400">
      <HeaderNav />
      <slot />
      <Footer />
    </div>
  </body>
</html>
