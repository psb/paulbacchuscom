---
import { Image } from "astro:assets";
import jtConfused from "../assets/images/jt-confused.png";
import Layout from "../layouts/Layout.astro";
const title = "404";
const ogImage = "00-homepage";
---

<Layout title={title} ogImage={ogImage}>
  <div>
    <Image src={jtConfused} alt="" layout="constrained" width={600} />
  </div>
  <h2>Page Not Found</h2>
</Layout>

<style>
  div {
    text-align: center;
  }
  h2 {
    font-weight: 800;
    text-align: right;
  }
</style>
