---
import { Image } from "astro:assets";
import jtConfused from "../assets/images/jt-confused.png";
import Layout from "../layouts/Layout.astro";
const title = "404. Page Not Found";
const description = "404. Page Not Found";
const ogImage = "404-og-image.png";
const ogType = "website";
const noFontFeatures = false;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  noFontFeatures={noFontFeatures}
>
  <div>
    <Image src={jtConfused} alt="" layout="constrained" width={600} />
  </div>
</Layout>

<style>
  div {
    text-align: center;
  }
</style>
