---
import { Image } from "astro:assets";
import jtConfused from "../assets/images/jt-confused.png";
import Layout from "../layouts/Layout.astro";
const title = "404";
---

<Layout title={title}>
  <div>
    <Image src={jtConfused} alt="" layout="constrained" width={700} />
    <h2>Page Not Found</h2>
  </div>
</Layout>

<style>
  div {
    text-align: center;
  }
  h2 {
    font-weight: 800;
  }
</style>
