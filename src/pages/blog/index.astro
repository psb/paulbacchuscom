---
import BlogPostsList from "../../components/BlogPostsList.astro";
import Layout from "../../layouts/Layout.astro";
const title = "Blog";
const description = "List of Paul Bacchus's blog posts.";
const ogImage = "00-homepage-og-image.png";
const ogType = "website";
const noFontFeatures = false;
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  noFontFeatures={noFontFeatures}
>
  <h2>All Posts</h2>
  <BlogPostsList limit={0} />
</Layout>
