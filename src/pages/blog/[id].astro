---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blogPosts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

import Layout from "../../layouts/Layout.astro";
const title = post.data.title;
const ogImage = post.data.ogImage;
const noFontFeatures = post.data.noFontFeatures ?? false;
---

<Layout title={title} ogImage={ogImage} noFontFeatures={noFontFeatures}>
  <Image
    src={post.data.coverImage}
    alt={post.data.coverImageAlt}
    layout="constrained"
    width={1000}
  />
  <div class="post-date">
    <p>
      <span>
        {`${post.data.day}`}
        <sup>{`${post.data.ordinal}`}</sup>{" "}
        {`${post.data.month}, ${post.data.year}`}
      </span>
    </p>
  </div>
  <Content />
  <div class="arrow-up">
    <a href="#body" aria-label="return to top">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"
        ><rect width="256" height="256" fill="none"></rect><path
          d="M232,128A104,104,0,1,0,128,232,104.11,104.11,0,0,0,232,128Zm-66.34-2.34a8,8,0,0,1-11.32,0L136,107.31V168a8,8,0,0,1-16,0V107.31l-18.34,18.35a8,8,0,0,1-11.32-11.32l32-32a8,8,0,0,1,11.32,0l32,32A8,8,0,0,1,165.66,125.66Z"
        ></path></svg
      >
    </a>
  </div>
</Layout>

<style>
  img {
    border-radius: 3px;
  }

  .post-date {
    margin-top: 2rem;
    margin-bottom: 3rem;
  }
  .post-date span {
    background-color: var(--color-date-background);
    color: var(--color-cyan);
    border: 1px solid var(--color-date-background);
    border-radius: 2px;
  }

  .arrow-up {
    text-align: right;
    padding-top: 1.5rem;
  }
  .arrow-up svg {
    max-width: 32px;
    animation: colorCycle 5s infinite;
  }
  @keyframes colorCycle {
    0% {
      fill: oklch(from var(--color-cyan) calc(l + 0.1) c h);
    }
    25% {
      fill: var(--color-magenta);
    }
    50% {
      fill: var(--color-yellow);
    }
    75% {
      fill: var(--color-black);
    }
    100% {
      fill: oklch(from var(--color-cyan) calc(l + 0.1) c h);
    }
  }
</style>
