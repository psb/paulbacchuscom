      <a class="no-style" href="/blog"> More &#10230; </a>
    </div> -->
  </section>
  <!-- <section>
    <h2>Latest Projects</h2>
  </section> -->
</Layout>

<style>
  .more {
    font-weight: 500;
    text-transform: uppercase;
    text-align: right;
    padding: 1rem 0;
  }

  .more:hover a {
    text-decoration: underline;
    text-decoration-thickness: var(--link-thickness);
  }
</style>
