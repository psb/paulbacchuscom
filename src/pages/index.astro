---
import Layout from "../layouts/Layout.astro";
import RightArrow from "../assets/icons/arrow-right.svg";
import BlogPostsList from "../components/BlogPostsList.astro";
const title = "Home";
---

<Layout title={title}>
  <section>
    <h2>Latest Posts</h2>
    <BlogPostsList limit={5} />

    <div>
      <a class="more" href="/blog">
        More <RightArrow fill="currentColor" />
      </a>
    </div>
  </section>
  <!-- <section>
    <h2>Latest Projects</h2>
  </section> -->
</Layout>

<style>
  .more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-headings);
    font-size: 2rem;
  }
</style>
