---
import Link from "../components/Link.astro";
import Layout from "../layouts/Layout.astro";
const title = "Home";
---

<Layout title={title}>
  <header class="mx-auto max-w-lg my-4" aria-description="Contact information">
    <h1>Contact</h1>
    <a href="#main" class="skip">Skip to main content</a>
    <div>
      Email:
      <Link href="mailto:hello@paulbacchus.com">hello@paulbacchus.com</Link>
    </div>
    <div>
      X:
      <Link href="https://x.com/psb_underscore">@psb_underscore</Link>
    </div>
    <div>
      GitHub:
      <Link href="https://github.com/psb">psb</Link>
    </div>
    <div>
      LinkedIn:
      <Link href="https://www.linkedin.com/in/paulsbacchus">Paul Bacchus</Link>
    </div>
  </header>

  <main id="main" class="flex justify-center">
    <article></article>
  </main>
</Layout>
