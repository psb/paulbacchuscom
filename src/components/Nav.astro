---
import House from "../assets/icons/house.svg";
import Article from "../assets/icons/text-align-justify.svg";
import Desktop from "../assets/icons/desktop-tower.svg";
import RSS from "../assets/icons/rss.svg";
---

<header>
  <nav>
    <a class="home" href="/">
      <House role="img" aria-label="home" />
    </a>
    <a class="blog" href="/blog">
      <Article role="img" aria-label="blog" />
    </a>
    <a class="projects" href="/projects">
      <Desktop role="img" aria-label="projects" />
    </a>
    <a class="rss" href="/rss.xml">
      <RSS fill="white" role="img" aria-label="rss" />
    </a>
  </nav>
</header>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  a {
    color: black;
    text-decoration: none;
    &:visited {
      color: black;
      text-decoration: none;
    }
    padding: 1rem;
  }

  .home {
    background-color: var(--cyan);
  }
  .blog {
    background-color: var(--magenta);
  }
  .projects {
    background-color: var(--yellow);
  }
  .rss {
    background-color: var(--black);
  }
</style>
