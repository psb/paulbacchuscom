---
import House from "../assets/house-line.svg";
import Article from "../assets/article.svg";
import Desktop from "../assets/desktop-tower.svg";
import RSS from "../assets/rss.svg";
---

<nav>
  <a href="/">
    <div><House role="img" aria-labelledby="home" /></div>
    <div id="home">Home</div>
  </a>
  <a href="/blog">
    <div><Article role="img" aria-labelledby="blog" /></div>
    <div id="blog">Blog</div>
  </a>
  <a href="/projects">
    <div>
      <Desktop role="img" aria-labelledby="projects" />
    </div>
    <div id="projects">Projects</div>
  </a>
  <a href="/rss.xml">
    <div><RSS role="img" aria-labelledby="rss" /></div>
    <div id="rss">Subscribe</div>
  </a>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0 0.25rem;
  }

  a {
    text-align: center;
  }

  a:link,
  a:visited {
    color: black;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 1.5px;
  }
</style>
