---
const thisYear = new Date().getFullYear();
---

<div class="footer">
  <div>
    &copy; 2023 &ndash; {thisYear} Paul Bacchus
  </div>
  <div>Icons from <a href="https://phosphoricons.com">Phosphor</a></div>
</div>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    background-color: var(--magenta);
    padding: 0.25rem;
    /* To push to bottom of page. See Layout also. */
    margin-top: auto;
  }

  a {
    color: var(--black);
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 1.5px;

    &:visited {
      color: var(--black);
    }

    &:hover {
      text-decoration: underline;
      text-decoration-style: wavy;
      text-decoration-thickness: 1.5px;
    }
  }
</style>
