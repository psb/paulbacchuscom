---
import Copyright from "../assets/icons/copyright.svg";

const thisYear = new Date().getFullYear();
---

<hr />
<div class="copyright">
  <div>
    <Copyright role="img" aria-label="copyright" width="24" height="24" />
  </div>
  <div>
    &copy; &nbsp; 2023 &ndash; {thisYear} Paul Bacchus
  </div>
</div>

<style>
  .copyright {
    display: flex;
    align-items: center;
  }
</style>
