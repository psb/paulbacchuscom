---
import { getCollection, getEntry } from "astro:content";

interface Props {
  limit: number;
}

const { limit } = Astro.props;

const blogPostsColl = await getCollection("blogPosts");

let blogPosts;
if (limit === 0) {
  blogPosts = blogPostsColl.sort((a, b) =>
    b.data.pubDate.localeCompare(a.data.pubDate),
  );
} else {
  blogPosts = blogPostsColl
    .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
    .slice(0, limit);
}
---

<ul>
  {
    blogPosts.map((post) => (
      <li>
        <a href={`/blog/${post.id}`}>
          <div class="post-title">{post.data.title}</div>
          <div class="post-date">
            {`${post.data.day}`}
            <sup>{`${post.data.ordinal}`}</sup>{" "}
            {`${post.data.month}, ${post.data.year}`}
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style-type: none;
    padding: 0;
  }

  li {
    padding: 0.5rem 0;
  }

  .post-title {
    font-size: 1.5rem;
  }

  .post-date {
    color: var(--grey);
  }
</style>
