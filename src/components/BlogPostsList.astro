---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

interface Props {
  limit: number;
}

const { limit } = Astro.props;

const blogPostsColl = await getCollection("blogPosts");

let blogPosts;
if (limit === 0) {
  blogPosts = blogPostsColl.sort((a, b) =>
    b.data.pubDate.localeCompare(a.data.pubDate),
  );
} else {
  blogPosts = blogPostsColl
    .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate))
    .slice(0, limit);
}
---

<ul>
  {
    blogPosts.map((post) => (
      <li>
        <a class="no-style card" href={`/blog/${post.id}`}>
          <Image
            src={post.data.coverImage}
            alt={post.data.coverImageAlt}
            layout="constrained"
          />
          <div class="post-title">{post.data.title}</div>
          <div class="post-date">
            <span>
              {`${post.data.day}`}
              <sup>{`${post.data.ordinal}`}</sup>{" "}
              {`${post.data.month}, ${post.data.year}`}
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style-type: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    grid-gap: 1rem;
  }

  li {
    border-radius: 3px;
    background-color: var(--color-card-background);
  }
  li:hover .post-title {
    text-decoration: underline;
    text-decoration-thickness: var(--link-thickness);
  }

  a.card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  img {
    width: 100%;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
  }

  .post-title {
    font-size: 1.5rem;
    padding: 1rem 0.5rem 0.5rem 0.5rem;
    text-wrap: balance;
    flex-grow: 1;
  }

  .post-date {
    padding: 0.25rem 0.5rem 0.5rem 0.5rem;
  }

  .post-date span {
    font-size: 1rem;
    background-color: var(--color-date-background);
    color: var(--color-cyan);
    border: 1px solid var(--color-date-background);
    border-radius: 2px;
  }
</style>
