---
import ExternalLinkIcon from "../assets/icons/arrow-square-out.svg";

interface Props {
  url: string;
  text: string;
}

const { url, text } = Astro.props;
---

<a href={url} target="_blank" rel="noreferrer" rel="noopener"
  >{text}
  <ExternalLinkIcon height="1rem" width="1rem" />
</a>

<style>
  a {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    color: var(--color-link);
    text-decoration-thickness: 1px;

    &:visited {
      color: var(--color-link);
    }

    &:hover {
      text-decoration-thickness: 2px;
    }
  }
</style>
