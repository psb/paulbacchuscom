---
import House from "../assets/icons/house-fill.svg";
import Article from "../assets/icons/text-align-justify-fill.svg";
import Desktop from "../assets/icons/desktop-fill.svg";
import RSS from "../assets/icons/rss-fill.svg";
---

<header>
  <nav>
    <a class="no-style" href="/">
      <House height="1rem" role="img" aria-label="home" />
      home
    </a>
    <a class="no-style" href="/blog">
      <Article height="1rem" role="img" aria-label="blog" />
      blog
    </a>
    <a class="no-style" href="/projects">
      <Desktop height="1rem" role="img" aria-label="projects" />
      projects
    </a>
    <a class="no-style" href="/rss.xml">
      <RSS height="1rem" role="img" aria-label="rss" />
      rss feed
    </a>
  </nav>
</header>

<style>
  header {
    padding: 1rem;
  }

  nav {
    display: flex;
    justify-content: space-between;
  }

  nav > a {
    display: flex;
    align-items: center;
    text-transform: uppercase;
    font-weight: 500;
    &:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      border-bottom: 1px solid var(--color-text);
    }
  }
</style>
