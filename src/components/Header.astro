---
import { Image } from "astro:assets";
import face from "../assets/images/face.png";
import House from "../assets/icons/house-fill.svg";
import Article from "../assets/icons/text-align-justify-fill.svg";
import Desktop from "../assets/icons/desktop-fill.svg";
import RSS from "../assets/icons/rss-fill.svg";
---

<header>
  <a class="face" href="/" aria-label="home">
    <Image src={face} alt="" layout="constrained" width={50} />
  </a>
  <nav>
    <div>
      <a class="no-style" href="/">
        <House
          height="1.2rem"
          width="1.2rem"
          role="img"
          aria-labelledby="home"
        />
        <span id="home"> home </span>
      </a>
    </div>
    <div>
      <a class="no-style" href="/blog">
        <Article
          height="1.2rem"
          width="1.2rem"
          role="img"
          aria-labelledby="blog"
        />
        <span id="blog"> blog </span>
      </a>
    </div>
    <!-- <a class="no-style" href="/projects">
      <Desktop
        height="1.2rem"
        width="1.2rem"
        role="img"
        aria-labelledby="projects"
      />
      <span id="projects"> projects </span>
    </a> -->
    <div>
      <a class="no-style" href="/rss.xml">
        <RSS height="1.2rem" width="1.2rem" role="img" aria-labelledby="rss" />
        <span id="rss"> rss </span>
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    padding: 1rem;
    /* with image of face in header */
    display: flex;
    align-content: center;
    justify-content: space-between;
  }

  .face {
    transform: rotate(-180deg);
    transition: transform 0.5s ease-in-out;
  }
  .face:hover {
    transform: rotate(0deg);
  }

  nav {
    display: flex;
    align-items: center;
    /* justify-content: space-between; */
    /* justify-content: end; */
    gap: 2rem;
  }

  nav > div > a {
    display: flex;
    align-items: center;
    text-transform: uppercase;
    font-weight: 600;
    gap: 0.3rem;
  }

  nav a:hover span {
    text-decoration: underline;
    text-decoration-thickness: var(--link-thickness);
  }
</style>
