---
import Email from "../assets/icons/envelope-simple.svg";
import X from "../assets/icons/x-logo.svg";
import GitHub from "../assets/icons/github-logo.svg";
import LinkedIn from "../assets/icons/linkedin-logo.svg";
---

<section>
  <div class="contact">
    <a
      class="email"
      href="mailto:hello@paulbacchus.com"
      aria-label="contact by email"
    >
      <Email fill="white" role="img" />
    </a>
    <a
      class="twitter"
      href="https://x.com/psb_underscore"
      aria-label="contact on x"
    >
      <X role="img" />
    </a>
    <a
      class="github"
      href="https://github.com/psb"
      aria-label="contact on git hub"
    >
      <GitHub role="img" />
    </a>
    <a
      class="linkedin"
      href="https://www.linkedin.com/in/paulsbacchus"
      aria-label="contact on linked in"
    >
      <LinkedIn role="img" />
    </a>
  </div>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  a {
    color: black;
    text-decoration: none;
    &:visited {
      color: black;
      text-decoration: none;
    }
    padding: 1rem 0.3rem;
  }

  .email {
    background-color: var(--black);
  }
  .twitter {
    background-color: var(--yellow);
  }
  .github {
    background-color: var(--magenta);
  }
  .linkedin {
    background-color: var(--cyan);
  }

  /* Styles for md: >=48rem (768px) */
  @media (width >= 48rem) {
    a {
      padding: 1rem;
    }
  }
</style>
