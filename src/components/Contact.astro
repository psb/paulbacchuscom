---
import At from "../assets/icons/at.svg";
import X from "../assets/icons/x-logo.svg";
import GitHub from "../assets/icons/github-logo.svg";
import LinkedIn from "../assets/icons/linkedin-logo.svg";
---

<section>
  <a href="#main" class="skip">Skip to main content</a>
  <h1>Paul Bacchus</h1>
  <div class="contact-links">
    <a href="mailto:hello@paulbacchus.com" aria-label="contact by email">
      <At role="img" />
    </a>
    <a href="https://x.com/psb_underscore" aria-label="contact on x">
      <X role="img" />
    </a>
    <a href="https://github.com/psb" aria-label="contact on git hub">
      <GitHub role="img" />
    </a>
    <a
      href="https://www.linkedin.com/in/paulsbacchus"
      aria-label="contact on linked in"
    >
      <LinkedIn role="img" />
    </a>
  </div>
</section>

<style>
  h1 {
    font-size: 4rem;
    font-weight: 700;
  }

  .contact-links {
    display: flex;
    gap: 20;
    padding: 0 0.25rem;
  }

  a:link,
  a:visited {
    color: black;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 1.5px;
  }
</style>
