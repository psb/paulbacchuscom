---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<inline-note aria-expanded="false" aria-owns={id} tabindex="0">
  <span class="chevron">❱</span>
  <span id={id} class="inner closed">
    <slot />
  </span>
</inline-note>

<style>
  inline-note {
    color: var(--color-magenta);
    background-color: var(--color-white);
    border-radius: 2px;

    &:hover {
      cursor: pointer;
    }

    &:focus-visible {
      box-shadow: 0 0 0 3px var(--color-magenta);
    }
  }

  .closed {
    display: none;
  }
</style>

<script>
  class InlineNote extends HTMLElement {
    connectedCallback() {
      const chevron = this.querySelector(".chevron");
      const innerSpan = this.querySelector(".inner");

      // open/show inner span, switch chevron and toggle aria-expanded
      this.addEventListener("click", () => {
        if (innerSpan?.classList.contains("closed")) {
          innerSpan?.classList.remove("closed");
          chevron!.innerHTML = "❰&nbsp;";
          this.setAttribute("aria-expanded", "true");
        } else {
          innerSpan?.classList.add("closed");
          chevron!.innerHTML = "❱";
          this.setAttribute("aria-expanded", "false");
        }
      });

      // handle keyboard expansion/click
      this.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault(); // prevent space scrolling
          this.click();
        }
      });
    }
  }

  customElements.define("inline-note", InlineNote);
</script>
